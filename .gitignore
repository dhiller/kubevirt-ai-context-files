# Deny everything by default
*

# Track this file
!.gitignore

# Top-level agent context
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!.mcp.json
!kilo.json

# Shared agent reference docs and skills
!.agents/
!.agents/references/
!.agents/references/**
!.agents/skills/
!.agents/skills/*/
!.agents/skills/**/SKILL.md

# Claude Code project settings and skills (not local settings or runtime state)
!.claude/
!.claude/settings.json
!.claude/skills/
!.claude/skills/*/
!.claude/skills/**/SKILL.md
!.claude/skills/copy-lanes
!.claude/skills/go-dev
!.claude/skills/pending-reviews

# kubevirt.io org-level agent context
!kubevirt.io/
!kubevirt.io/AGENTS.md
!kubevirt.io/CLAUDE.md
!kubevirt.io/GEMINI.md
!kubevirt.io/.gemini/
!kubevirt.io/.gemini/settings.json
!kubevirt.io/.gemini/skills/
!kubevirt.io/.gemini/skills/*/
!kubevirt.io/.gemini/skills/**/SKILL.md

# Keep Skyconqueror repositories and local context untracked
/skyconqueror/
